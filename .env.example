MYSQL_HOST=host.docker.internal
MYSQL_USER=root
MYSQL_PASSWORD=Root@12345
MYSQL_DATABASE=eventmitra
MYSQL_PORT=3306

BACKEND_PORT=8080
FRONTEND_PORT=3000
NOTIFICATION_PORT=5224

APP_JWT_SECRET=change-this-to-a-very-long-256-bit-secret-for-production
APP_JWT_EXPIRATION_MS=86400000

RAZORPAY_KEY_ID=rzp_test_key
RAZORPAY_KEY_SECRET=rzp_test_secret
RAZORPAY_CURRENCY=INR

SPRING_AI_OPENAI_API_KEY=your-groq-or-openai-compatible-api-key
SPRING_AI_OPENAI_BASE_URL=https://api.groq.com/openai
SPRING_AI_OPENAI_CHAT_OPTIONS_MODEL=llama-3.3-70b-versatile

EMAIL_SENDER_EMAIL=eventmitraproject@gmail.com
EMAIL_SENDER_NAME=EventMitra
EMAIL_PASSWORD=your-smtp-app-password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

VITE_API_BASE_URL=/api/backend

APP_BOOTSTRAP_ADMIN_ENABLED=false
APP_BOOTSTRAP_ADMIN_EMAIL=admin@eventmitra.local
APP_BOOTSTRAP_ADMIN_PASSWORD=change-this-admin-password
APP_BOOTSTRAP_ADMIN_FULL_NAME=EventMitra Admin
APP_BOOTSTRAP_ADMIN_MOBILE_NUMBER=9999999999
