{
  "openapi": "3.0.1",
  "info": {
    "title": "EventMitra.NotificationService",
    "version": "1.0"
  },
  "paths": {
    "/api/Notification/send-email": {
      "post": {
        "tags": [
          "Notification"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/EmailRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
